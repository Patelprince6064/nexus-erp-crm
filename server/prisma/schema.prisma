generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  role             String             @default("SALES")
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  createdCustomers Customer[]
  createdFollowUps CustomerFollowUp[]
  createdMovements StockMovement[]
  createdChallans  Challan[]

  @@index([email])
}

model Customer {
  id           String           @id @default(uuid())
  name         String
  mobile       String
  email        String
  businessName String
  gstNumber    String?
  customerType String           @default("WHOLESALE")
  address      String
  status       String           @default("LEAD")
  followUpDate DateTime?
  notes        String?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  followUps    CustomerFollowUp[]
  challans     Challan[]

  @@index([mobile])
  @@index([email])
  @@index([businessName])
  @@index([status])
  @@index([customerType])
}

model CustomerFollowUp {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note         String
  followUpDate DateTime
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([customerId])
}

model Product {
  id                 String          @id @default(uuid())
  name               String
  sku                String          @unique
  category           String
  unitPrice          Float
  currentStock       Int             @default(0)
  minimumStockAlert  Int             @default(10)
  warehouseLocation  String
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  stockMovements     StockMovement[]
  challanItems       ChallanItem[]

  @@index([sku])
  @@index([name])
  @@index([category])
}

model StockMovement {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  movementType String
  reason       String
  referenceId  String?
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        String        @default("DRAFT")
  totalQuantity Int           @default(0)
  subtotal      Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float         @default(0)
  notes         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         ChallanItem[]

  @@index([challanNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model ChallanItem {
  id                  String   @id @default(uuid())
  challanId           String
  challan             Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
  subtotal            Float

  @@index([challanId])
  @@index([productId])
}
