          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 200,\n  \"movementType\": \"IN\",\n  \"reason\": \"Purchase Order PO-2026-005 - Received from Ashok Fasteners\",\n  \"referenceId\": \"PO-2026-005\"\n}"},
            "url": {"raw": "{{baseUrl}}/inventory/movement", "host": ["{{baseUrl}}"], "path": ["inventory", "movement"]}
          }
        },
        {
          "name": "Record Stock OUT (Manual Adjustment)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 10,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Factory usage - production floor adjustment\"\n}"},
            "url": {"raw": "{{baseUrl}}/inventory/movement", "host": ["{{baseUrl}}"], "path": ["inventory", "movement"]}
          }
        },
        {
          "name": "Record Stock OUT - Insufficient (Should Return 400)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 999999,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Testing insufficient stock validation\"\n}"},
            "url": {"raw": "{{baseUrl}}/inventory/movement", "host": ["{{baseUrl}}"], "path": ["inventory", "movement"]}
          }
        }
      ]
    },
    {
      "name": "📄 Sales Challans",
      "item": [
        {
          "name": "List Challans (paginated)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/challans?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["challans"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}]}
          }
        },
        {
          "name": "Filter Challans by Status",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/challans?status=CONFIRMED", "host": ["{{baseUrl}}"], "path": ["challans"], "query": [{"key": "status", "value": "CONFIRMED"}]}
          }
        },
        {
          "name": "Search Challans by Number",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/challans?search=CH-2026", "host": ["{{baseUrl}}"], "path": ["challans"], "query": [{"key": "search", "value": "CH-2026"}]}
          }
        },
        {
          "name": "Get Challan By ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/challans/{{challanId}}", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}"]}
          }
        },
        {
          "name": "Create DRAFT Challan (No Stock Deduction)",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.success) pm.collectionVariables.set('challanId', json.data.id);"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"notes\": \"Trial quotation for Apex Industries bulk fastener order Q3.\",\n  \"taxPercentage\": 18,\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 50 }\n  ]\n}"},
            "url": {"raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"]}
          }
        },
        {
          "name": "Update DRAFT Challan Items",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"notes\": \"Updated delivery instructions. Rush order.\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 30 }\n  ]\n}"},
            "url": {"raw": "{{baseUrl}}/challans/{{challanId}}", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}"]}
          }
        },
        {
          "name": "Confirm Challan (Atomic Stock Deduction)",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/challans/{{challanId}}/confirm", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}", "confirm"]}
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/challans/{{challanId}}/cancel", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}", "cancel"]}
          }
        }
      ]
    }
