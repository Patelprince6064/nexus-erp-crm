          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Aarav Kumar\",\n  \"email\": \"aarav@erp-demo.com\",\n  \"password\": \"Aarav@123\",\n  \"role\": \"SALES\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"]}
