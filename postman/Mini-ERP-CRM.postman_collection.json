    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.success) {", "  pm.collectionVariables.set('token', json.data.token);", "  pm.collectionVariables.set('userId', json.data.user.id);", "}"], "type": "text/javascript"}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@erp-demo.com\",\n  \"password\": \"Admin@123\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
