{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete REST API collection for Mini ERP + CRM Portal. Import this collection and set the `baseUrl` variable to your deployed server URL.",
