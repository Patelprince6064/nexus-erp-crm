    {
      "name": "👥 Customers CRM",
      "item": [
        {
          "name": "List Customers (paginated)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/customers?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}]}
          }
        },
        {
          "name": "Search Customers",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/customers?search=apex&status=ACTIVE&customerType=DISTRIBUTOR", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{"key": "search", "value": "apex"}, {"key": "status", "value": "ACTIVE"}, {"key": "customerType", "value": "DISTRIBUTOR"}]}
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"]}
          }
        },
        {
          "name": "Create New Customer",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.success) pm.collectionVariables.set('customerId', json.data.id);"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Ravi Verma\",\n  \"mobile\": \"+91 98765 43210\",\n  \"email\": \"ravi@indoparts.com\",\n  \"businessName\": \"Indo Parts & Components Pvt Ltd\",\n  \"gstNumber\": \"27AAACI1234D1Z9\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"Plot 7, MIDC Pimpri, Pune, Maharashtra 411018\",\n  \"status\": \"LEAD\",\n  \"notes\": \"Interested in monthly supply of fasteners.\"\n}"},
            "url": {"raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"]}
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\",\n  \"notes\": \"First order placed. Moving to Active.\"\n}"},
            "url": {"raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"]}
          }
        },
        {
          "name": "Deactivate Customer",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"]}
          }
        },
        {
          "name": "Get Customer Follow-ups",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/customers/{{customerId}}/followups", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "followups"]}
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"note\": \"Spoke with client. Interested in 500 units of M8 bolts. Sending quotation by EOD.\",\n  \"followUpDate\": \"2026-08-15\"\n}"},
            "url": {"raw": "{{baseUrl}}/customers/{{customerId}}/followups", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "followups"]}
          }
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "List Products (paginated)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/products?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}]}
          }
        },
        {
          "name": "Search Products by SKU/Name",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/products?search=HEX&category=Fasteners", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{"key": "search", "value": "HEX"}, {"key": "category", "value": "Fasteners"}]}
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"]}
          }
        },
        {
          "name": "Create Product",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.success) pm.collectionVariables.set('productId', json.data.id);"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Hex Bolt Stainless Steel M6 x 30mm\",\n  \"sku\": \"FAST-HEX-M6-30\",\n  \"category\": \"Fasteners\",\n  \"unitPrice\": 12.50,\n  \"currentStock\": 1000,\n  \"minimumStockAlert\": 200,\n  \"warehouseLocation\": \"Rack A-08\"\n}"},
            "url": {"raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"]}
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"unitPrice\": 14.00,\n  \"minimumStockAlert\": 250\n}"},
            "url": {"raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"]}
          }
